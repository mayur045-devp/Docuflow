{
	"kind": "collectionType",
	"collectionName": "articles",
	"info": {
		"singularName": "article",
		"pluralName": "articles",
		"displayName": "Article",
		"description": "Editorial articles and blog posts"
	},
	"options": {
		"draftAndPublish": true
	},
	"pluginOptions": {},
	"attributes": {
		"title": {
			"type": "string",
			"required": true
		},
		"slug": {
			"type": "uid",
			"targetField": "title",
			"required": true
		},
		"summary": {
			"type": "text"
		},
		"body": {
			"type": "richtext"
		},
		"status": {
			"type": "enumeration",
			"enum": ["draft", "review", "published"],
			"default": "draft"
		},
		"authorName": {
			"type": "string"
		},
		"featuredImage": {
			"type": "media",
			"multiple": false,
			"required": false,
			"allowedTypes": ["images"]
		}
	}
}
