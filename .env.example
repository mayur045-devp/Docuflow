# ==========================================
# DocuFlow - Environment Configuration
# ==========================================

# Strapi CMS Configuration
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your_strapi_api_token_here
STRAPI_VERSION=auto
# Optional live admin schema discovery:
STRAPI_ADMIN_EMAIL=
STRAPI_ADMIN_PASSWORD=
# Optional local Strapi path (reads src/api/*/content-types/*/schema.json):
STRAPI_PROJECT_PATH=
# Optional admin UI URL (defaults to STRAPI_URL/admin):
STRAPI_ADMIN_URL=

# AI Provider Configuration
# Set to 'mock' for offline testing without Gemini API key, or 'gemini' for real extraction
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_RETRIES=2

# App Security & Storage
APP_PASSWORD=change_this_password_123!
SESSION_SECRET=a_very_long_random_session_secret_at_least_32_characters_long
MAX_UPLOAD_MB=10
DATA_DIR=.data
JOB_TTL_DAYS=30

