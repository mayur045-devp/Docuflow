# ==========================================
# DocuFlow - Environment Configuration
# ==========================================

# Strapi Pre-Production CMS Configuration (Single Source of Truth)
STRAPI_URL=https://strapi-preprod.12thwonder.com
STRAPI_API_TOKEN=
STRAPI_VERSION=5
STRAPI_ADMIN_URL=https://strapi-preprod.12thwonder.com/admin

# AI Provider Configuration
# Set to 'mock' for heuristic mapping or 'gemini' for Gemini API
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_RETRIES=2

# App Security & Storage
APP_PASSWORD=change_this_password_123!
SESSION_SECRET=a_very_long_random_session_secret_at_least_32_characters_long
MAX_UPLOAD_MB=10
DATA_DIR=.data
JOB_TTL_DAYS=30
